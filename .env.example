# Local demo starts without an .env file. Copy this file to .env to override defaults.
PUBLIC_BASE_URL=http://localhost
HTTP_PORT=80
# Use a long random alphanumeric value before exposing the service publicly.
# Password is inserted into a URL: use letters/digits or URL-encode special characters.
POSTGRES_PASSWORD=qr_local_demo
# Empty: auto-generate once and persist in the app_data Docker volume.
APP_SECRET=
COOKIE_SECURE=false
TIMEZONE=Europe/Moscow
# Shared campus Wi-Fi has many students behind one IP. This is NOT one check-in per IP.
IP_RATE_LIMIT=120
